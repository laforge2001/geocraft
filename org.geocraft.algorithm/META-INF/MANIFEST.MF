Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Algorithm Plug-in
Bundle-SymbolicName: org.geocraft.algorithm;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Activator: org.geocraft.algorithm.Activator
Bundle-Vendor: ConocoPhillips
Require-Bundle: org.eclipse.ui,
 org.eclipse.core.runtime,
 org.geocraft.ui.form2,
 org.eclipse.ui.forms,
 org.geocraft.ui.common,
 org.geocraft.core.session,
 org.geocraft.core,
 org.geocraft.io.util
Bundle-RequiredExecutionEnvironment: JavaSE-21
Bundle-ActivationPolicy: lazy
Export-Package: org.geocraft.algorithm,
 org.geocraft.algorithm.example,
 org.geocraft.algorithm.thread,
 org.geocraft.internal.algorithm;x-internal:=true
Service-Component: OSGI-INF/component.xml
