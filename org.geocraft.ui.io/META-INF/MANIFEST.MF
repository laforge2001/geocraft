Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: I/O UI Plug-in
Bundle-SymbolicName: org.geocraft.ui.io;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Vendor: ConocoPhillips
Bundle-RequiredExecutionEnvironment: JavaSE-21
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.ui,
 org.eclipse.ui.forms,
 org.eclipse.core.databinding,
 org.geocraft.core,
 org.geocraft.core.session,
 org.geocraft.ui.model,
 org.geocraft.ui.common,
 org.geocraft.algorithm,
 org.geocraft.ui.form2
Export-Package: org.geocraft.internal.ui.io;x-internal:=true,
 org.geocraft.ui.io;
  uses:="org.eclipse.swt.events,
   org.geocraft.internal.ui.io,
   org.geocraft.core.model.validation,
   org.geocraft.core.io,
   org.geocraft.core.model.datatypes,
   org.eclipse.ui.forms,
   org.geocraft.core.common.preferences,
   org.geocraft.core.model.mapper,
   org.eclipse.swt.widgets,
   org.geocraft.ui.form2",
 org.geocraft.ui.io.actions;uses:="org.eclipse.jface.action,org.eclipse.ui,org.eclipse.jface.viewers"
Service-Component: META-INF/OSGI-INF/component.xml, META-INF/OSGI-INF/component2.xml
Bundle-ActivationPolicy: lazy
