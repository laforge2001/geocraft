Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: GeoCraft
Bundle-SymbolicName: org.geocraft.product;singleton:=true
Bundle-Version: 1.0.0.qualifier
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.ui,
 org.eclipse.ui.forms,
 org.eclipse.core.filesystem,
 org.eclipse.core.resources,
 org.geocraft.core;bundle-version="1.0.0",
 org.geocraft.core.session;bundle-version="1.0.0",
 org.geocraft.ui.model;bundle-version="1.0.0",
 org.geocraft.ui.common;bundle-version="1.0.0"
Bundle-Vendor: ConocoPhillips
Bundle-RequiredExecutionEnvironment: JavaSE-21
Export-Package: org.geocraft;uses:="org.eclipse.equinox.app",
 org.geocraft.product;uses:="org.eclipse.jface.action,org.eclipse.ui.application,org.eclipse.ui",
 org.geocraft.product.action;uses:="org.eclipse.jface.action,org.eclipse.ui.views,org.eclipse.ui",
 org.geocraft.product.intro;
  uses:="org.eclipse.ui.intro,
   org.eclipse.ui,
   org.eclipse.swt.graphics,
   org.eclipse.swt.widgets",
 org.geocraft.product.workspace
Bundle-Activator: org.geocraft.Activator
Bundle-ClassPath: .,
 lib/commons-io-1.4.jar
Import-Package: org.geocraft.core.common.preferences,
 org.geocraft.core.common.util
