Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Form Plug-in
Bundle-SymbolicName: org.geocraft.ui.form2;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Activator: org.geocraft.ui.form2.Activator
Bundle-Vendor: ConocoPhillips
Require-Bundle: org.eclipse.ui,
 org.eclipse.core.runtime,
 org.eclipse.core.databinding,
 org.eclipse.ui.forms,
 org.eclipse.ui.views,
 org.geocraft.core,
 org.geocraft.ui.common
Bundle-RequiredExecutionEnvironment: JavaSE-21
Bundle-ActivationPolicy: lazy
Export-Package: org.geocraft.ui.form2,
 org.geocraft.ui.form2.field,
 org.geocraft.ui.form2.field.aoi
Service-Component: META-INF/OSGI-INF/component.xml
