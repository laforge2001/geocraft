Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Remote Plug-in
Bundle-SymbolicName: org.geocraft.io.remote;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Vendor: COP
Bundle-RequiredExecutionEnvironment: JavaSE-21
Require-Bundle: org.geocraft.io.jms,
 org.geocraft.ui.sectionviewer,
 org.geocraft.ui.mapviewer,
 org.eclipse.ui,
 org.geocraft.ui.viewer,
 org.eclipse.ui.views,
 org.eclipse.core.runtime,
 org.geocraft.io.javaseis,
 org.geocraft.ui.form2,
 org.geocraft.core,
 org.eclipse.osgi.services
Service-Component: META-INF/OSGI-INF/component.xml, META-INF/OSGI-INF2/component2.xml
Export-Package: org.geocraft.io.remote
Eclipse-PlatformFilter: (osgi.os=linux)
